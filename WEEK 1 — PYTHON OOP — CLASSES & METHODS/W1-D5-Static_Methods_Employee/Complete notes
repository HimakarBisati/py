**W1-D5-Static_Methods_Employee**

---

**What and Why:**
Yesterday you learned `@classmethod` which works on the class using `cls`. Today you learn `@staticmethod` — a method that belongs to the class but doesn't need `self` or `cls` at all. It's just a helper/utility function kept inside the class because it's logically related. Real backend code is full of static methods for validation — checking salary range, email format, password strength before saving to database.

---

```python
# ============================================================
# CONCEPT 1: STATIC METHOD — NO SELF, NO CLS
# ============================================================

class Employee:
    total_employees = 0
    company_name = "TechCorp"

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
        Employee.total_employees += 1

        if not Employee.is_valid_salary(salary):
            # calling static method inside __init__ to validate before saving
            # if salary invalid, print warning but still create object
            print(f"Warning: {name} has invalid salary")

        if not Employee.is_valid_name(name):
            # validate name before saving
            print(f"Warning: {name} is not a valid name")

    @classmethod
    def get_total_employees(cls):
        return cls.total_employees

    @classmethod
    def from_string(cls, data_string):
        name, salary = data_string.split("-")
        return cls(name, int(salary))

    @staticmethod
    def is_valid_salary(salary):
        # @staticmethod — no self, no cls
        # doesn't need any object's data or class data
        # just takes a value, checks it, returns True or False
        # pure utility function — logically related to Employee but independent
        return salary > 0
        # True if salary positive, False if zero or negative

    @staticmethod
    def calculate_bonus(salary, percentage):
        # pure calculation — doesn't need object or class data
        # takes two numbers, returns result
        return salary * (percentage / 100)
        # example: calculate_bonus(30000, 10) = 3000.0

    @staticmethod
    def is_valid_name(name):
        return name.isalpha() and len(name) > 0
        # isalpha() = True only if ALL characters are letters
        # "Ravi" = True
        # "Ravi123" = False — contains numbers
        # "" = False — empty string
        # and len(name) > 0 = makes sure name not empty


# ============================================================
# CREATING OBJECTS AND TESTING
# ============================================================

e1 = Employee("Ravi", 30000)    # valid — no warning
e2 = Employee("Sai", -5000)     # invalid salary — prints warning
e3 = Employee("Ravi123", 40000) # invalid name — prints warning

print(Employee.is_valid_salary(30000))      # True
print(Employee.is_valid_salary(-100))       # False
print(Employee.calculate_bonus(30000, 10))  # 3000.0
print(Employee.is_valid_name("Ravi"))       # True
print(Employee.is_valid_name("Ravi123"))    # False
print(Employee.company_name)                # TechCorp
print(Employee.get_total_employees())       # 3
```

