```python
# ============================================================
# COMMON MISTAKE — WHAT BREAKS WITHOUT @STATICMETHOD
# ============================================================

class EmployeeWrong:
    def is_valid_salary(salary):
        # no @staticmethod decorator
        # no self parameter
        return salary > 0

e1 = EmployeeWrong()
e1.is_valid_salary(30000)
# CRASH: TypeError: is_valid_salary() takes 1 positional argument but 2 were given
# Python automatically passes e1 as first argument
# but there's no self parameter to receive it
# @staticmethod tells Python: don't pass anything automatically


class EmployeeCorrect:
    @staticmethod
    def is_valid_salary(salary):
        # @staticmethod = Python skips auto-passing object
        # salary receives 30000 correctly
        return salary > 0
```

