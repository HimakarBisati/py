# ============================================================
# CONCEPT 2: THREE METHOD TYPES — FULL COMPARISON
# ============================================================

class Example:
    class_variable = "shared"

    def instance_method(self):
        # has self — works on one specific object's data
        # called as: obj.instance_method()
        # use when: you need this object's data (self.name, self.balance)
        print(self.class_variable)  # can access class variable too

    @classmethod
    def class_method(cls):
        # has cls — works on class itself and class variables
        # called as: Example.class_method() or obj.class_method()
        # use when: you need class-level data or creating objects
        print(cls.class_variable)

    @staticmethod
    def static_method(value):
        # no self, no cls — independent utility function
        # called as: Example.static_method(value)
        # use when: logic is related to class but needs no object/class data
        # validation, calculations, formatting
        return value > 0
```

