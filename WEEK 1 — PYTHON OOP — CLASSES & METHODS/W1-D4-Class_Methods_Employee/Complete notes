```python
# ============================================================
# COMMON MISTAKE — self vs Employee for class variable
# ============================================================

class EmployeeWrong:
    total_employees = 0

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
        self.total_employees += 1
        # WRONG — self.total_employees creates SEPARATE copy on each object
        # e1.total_employees = 1
        # e2.total_employees = 1
        # e3.total_employees = 1
        # Employee.total_employees stays 0 — shared counter never updated
        # no crash, silently wrong — most dangerous kind of bug


class EmployeeCorrect:
    total_employees = 0

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
        Employee.total_employees += 1
        # CORRECT — updates the shared class variable
        # all objects share same counter, grows correctly
```

---

```python
# ============================================================
# CONCEPT 3: CALLING CLASSMETHOD — TWO WAYS
# ============================================================

e1 = Employee("Ravi", 30000)

# Way 1 — call on class directly (recommended)
print(Employee.get_total_employees())  # 1

# Way 2 — call on object (also works but not recommended)
print(e1.get_total_employees())  # 1 — same result

# both work because classmethod is accessible from both
# but calling on class makes it clear it's a class-level operation
```

---

```python
# ============================================================
# DJANGO CONNECTION — HOW THIS LOOKS IN REAL PROJECT
# ============================================================

# Django ORM uses this exact pattern:

Post.objects.all()
# Post = class
# objects = Django's built-in class-level manager
# all() = classmethod that returns all Post records from database

Post.objects.create(title="Hello", content="World")
# create() = classmethod — creates new Post object and saves to database
# called on class (Post), not one object — same as Employee.from_string()

Post.objects.filter(title="Hello")
# filter() = classmethod — returns matching records
# same pattern as get_total_employees() — works on class level data
```

