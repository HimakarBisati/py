# ============================================================
# CONCEPT 2: WHY RETURN NOT PRINT — CRITICAL TO UNDERSTAND
# ============================================================

# WRONG WAY — using print inside average()
class StudentWrong:
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks

    def average(self):
        print(sum(self.marks) / len(self.marks))
        # print shows value on screen BUT returns None by default
        # function with no return statement always returns None

    def result(self):
        avg = self.average()
        # avg = None here, not a number
        # average() printed the value but didn't send it back
        if avg >= 40:
            # None >= 40 = TypeError: crash
            # this is why return matters
            return "Pass"


# CORRECT WAY — using return inside average()
class StudentCorrect:
    def average(self):
        return sum(self.marks) / len(self.marks)
        # return sends actual number back
        # avg in result() gets real number, not None
        # no crash, works correctly
```

