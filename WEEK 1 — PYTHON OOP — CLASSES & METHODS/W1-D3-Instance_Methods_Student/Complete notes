# ============================================================
# CONCEPT 3: METHOD CALLING ANOTHER METHOD
# ============================================================

class Calculator:
    def __init__(self, numbers):
        self.numbers = numbers

    def total(self):
        return sum(self.numbers)
        # returns total of all numbers

    def count(self):
        return len(self.numbers)
        # returns how many numbers

    def average(self):
        return self.total() / self.count()
        # calling self.total() and self.count() inside same class
        # reusing existing methods instead of rewriting logic
        # this is exactly how real backend code is structured


c1 = Calculator([10, 20, 30, 40])
print(c1.average())  # 25.0
```

