class JobApplication(models.Model):
    resume_score = models.IntegerField()
    status = models.CharField()

    def is_shortlisted(self):
        # same as is_pass() — decision based on object's own data
        return self.resume_score >= 70

    def get_status_display(self):
        # same as result() — returns value based on object data
        if self.resume_score >= 70:
            return "Shortlisted"
        return "Rejected"

# is_shortlisted() and get_status_display() = same pattern as
# result() and grade() in Student class
