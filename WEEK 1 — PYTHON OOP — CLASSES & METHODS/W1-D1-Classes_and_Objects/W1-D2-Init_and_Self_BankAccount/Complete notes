# ============================================================
# COMMON MISTAKE — WHY self.balance NOT local variable
# ============================================================

def deposit_wrong(self, amount):
    balance = self.balance + amount
    # balance here is a LOCAL variable — exists only inside this method
    # the moment method finishes, this value is GONE
    # self.balance is never updated — object still has old balance
    print(f"New balance: {balance}")  # shows correct value THIS time only
    # next time you check self.balance — it's still the old value
    # always use self.balance to update, never a local variable

# CORRECT WAY:
def deposit_correct(self, amount):
    self.balance += amount  # updates permanently on the object
```

