# In your SaaS Expense Manager (Week 10), you will write:

class Expense(models.Model):
    amount = models.IntegerField()
    status = models.CharField()  # "pending", "approved", "rejected"

    def approve(self):
        # same as withdraw() — changing state on the object
        self.status = "approved"
        self.save()  # Django's way of saving changed state to database

    def reject(self):
        self.status = "rejected"
        self.save()

# approve() and reject() = same pattern as deposit() and withdraw()
# self.status changes = same as self.balance changing
# self.save() = Django saves the changed state to database
```

