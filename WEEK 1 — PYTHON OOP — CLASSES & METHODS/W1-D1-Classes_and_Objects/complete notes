```python
# ============================================================
# CONCEPT 2: PERSON CLASS — PRACTICE SAME PATTERN
# ============================================================

class Person:
    def __init__(self, name, age, city):
        self.name = name   # save name permanently on this object
        self.age = age     # save age permanently on this object
        self.city = city   # save city permanently on this object

    def introduce(self):
        # f-string uses this object's own saved data
        print(f"Hi I'm {self.name}, {self.age}, from {self.city}")

    def is_adult(self):
        return self.age >= 18
        # True if age 18 or above
        # False if below 18


p1 = Person("Ravi", 22, "Hyderabad")
p2 = Person("Sai", 16, "Bangalore")

p1.introduce()        # Hi I'm Ravi, 22, from Hyderabad
print(p1.is_adult())  # True
p2.introduce()        # Hi I'm Sai, 16, from Bangalore
print(p2.is_adult())  # False
```

