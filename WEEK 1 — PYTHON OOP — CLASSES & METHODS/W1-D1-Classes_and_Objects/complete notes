# ============================================================
# CONCEPT 3: ANIMAL CLASS
# ============================================================

class Animal:
    def __init__(self, name, species):
        self.name = name
        self.species = species

    def make_sound(self):
        print("Some generic animal sound")
        # all animals print same sound today
        # Week 2 Inheritance — each animal gets its own sound
        # Dog says Woof, Cat says Meow etc — don't worry about it now


a1 = Animal("Rex", "Dog")
a2 = Animal("Milo", "Cat")
a3 = Animal("Kiwi", "Bird")

a1.make_sound()  # Some generic animal sound
a2.make_sound()  # Some generic animal sound
a3.make_sound()  # Some generic animal sound
```

