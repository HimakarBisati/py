# ============================================================
# DJANGO CONNECTION — HOW THIS LOOKS IN REAL PROJECT
# ============================================================

# In your AI Job Portal project (Week 7), you will write:

class Job(models.Model):        # Job = class (blueprint for job table)
    title = models.CharField()  # self.title = attribute on each job object
    company = models.CharField()
    salary = models.IntegerField()

    def is_high_paying(self):   # method on job object — same as is_new() on Car
        return self.salary >= 100000

# Every job posted in your app = one Job object
# Same exact pattern as Car/Person/Animal — just connected to database
```

