**What and Why:**
Class = blueprint. Object = real thing built from it. Every Django model, view, serializer is a class. This is the foundation — everything in your two projects uses this pattern.

---

```python
# ============================================================
# CONCEPT 1: CLASS AND OBJECT
# ============================================================

class Car:  # 'class' keyword creates a blueprint called Car
            # Car is not a real car yet — just the design

    def __init__(self, brand, model, year):
        # __init__ = special method called constructor
        # runs AUTOMATICALLY the moment you create an object
        # you never call __init__ yourself — Python calls it for you
        # self = this specific object being created right now
        # brand, model, year = values you pass in when creating object

        self.brand = brand
        # self.brand = creating an attribute called 'brand' ON this object
        # = brand means: take the value passed in and store it permanently
        # WITHOUT this line: value 'brand' exists only inside __init__
        # and disappears the moment __init__ finishes — permanently lost

        self.model = model  # same — permanently save model on this object
        self.year = year    # same — permanently save year on this object

    def display_info(self):
        # method = function that belongs to this class
        # self = this specific object calling the method
        # self gives access to this object's own saved data
        print(f"{self.year} {self.brand} {self.model}")
        # uses self.year, self.brand, self.model saved in __init__

    def is_new(self):
        return self.year >= 2023
        # return = sends value back to whoever called this method
        # >= 2023 = True if year is 2023 or above, False if not
        # return is NOT print — return gives value back, print just shows it


# ============================================================
# CREATING OBJECTS
# ============================================================

car1 = Car("Toyota", "Corolla", 2022)
# Car("Toyota", "Corolla", 2022) = create new object from Car blueprint
# Python automatically calls __init__ with these values
# self = car1, brand = "Toyota", model = "Corolla", year = 2022
# car1 now permanently holds: brand=Toyota, model=Corolla, year=2022

car2 = Car("Honda", "Civic", 2023)
# completely separate object from car1
# car2 holds its own data — changing car1 NEVER affects car2

car1.display_info()   # 2022 Toyota Corolla
car2.display_info()   # 2023 Honda Civic
# same method, different objects, different output
# self becomes car1 when car1 calls it
# self becomes car2 when car2 calls it

print(car1.is_new())  # False — 2022 is not >= 2023
print(car2.is_new())  # True — 2023 is >= 2023
```

