```python
# ============================================================
# DJANGO CONNECTION — HOW THIS LOOKS IN REAL PROJECT
# ============================================================

# Library class = Django database table
# Book object = one row in database table
# self.books list = all rows in table

# What you built manually:          What Django does automatically:
# lib.add_book(book)          →     post.save()
# lib.search_book(title)      →     Post.objects.get(title=title)
# lib.remove_book(title)      →     post.delete()
# lib.show_all_books()        →     Post.objects.all()
# lib.available_books()       →     Post.objects.filter(is_available=True)
# lib.borrow_book(title)      →     post.is_available = False; post.save()

# You built Django ORM manually today
# When you see Post.objects.filter() next week — you know exactly what's happening
