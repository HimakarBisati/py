# QUICK REFERENCE — ALL THREE CLASSES

class BankAccount:
    def __init__(self, owner, balance):
        self.owner = owner
        self.balance = balance

    def deposit(self, amount):
        if amount <= 0: print("Invalid"); return
        self.balance += amount

    def withdraw(self, amount):
        if amount <= 0: print("Invalid"); return
        if amount > self.balance: print("Insufficient"); return
        self.balance -= amount

    def show_balance(self):
        print(f"{self.owner}: {self.balance}")

    def transfer(self, other, amount):
        if amount > self.balance: print("Insufficient"); return
        self.balance -= amount
        other.balance += amount


class Student:
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks

    def average(self):
        return sum(self.marks) / len(self.marks)

    def result(self):
        return "Pass" if self.average() >= 40 else "Fail"

    def grade(self):
        avg = self.average()
        if avg >= 75: return "A"
        elif avg >= 60: return "B"
        elif avg >= 40: return "C"
        else: return "F"

    def highest_mark(self): return max(self.marks)
    def lowest_mark(self): return min(self.marks)


class Employee:
    total_employees = 0
    company_name = "TechCorp"

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
        Employee.total_employees += 1
        if not Employee.is_valid_salary(salary):
            print(f"Warning: invalid salary")

    @classmethod
    def get_total_employees(cls):
        return cls.total_employees

    @classmethod
    def from_string(cls, data):
        name, salary = data.split("-")
        return cls(name, int(salary))

    @staticmethod
    def is_valid_salary(salary): return salary > 0
    @staticmethod
    def calculate_bonus(salary, pct): return salary * (pct/100)
    @staticmethod
    def is_valid_name(name): return name.isalpha() and len(name) > 0
```

