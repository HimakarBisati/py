```bash
# ============================================================
# COMPLETE SETUP — DO THIS NOW FOR YOUR PROJECT
# ============================================================

# 1. Create project folder
mkdir backend-dev
cd backend-dev

# 2. Create venv
python -m venv venv

# 3. Activate venv
venv\Scripts\activate          # Windows
# source venv/bin/activate     # Mac/Linux

# 4. Install required packages
pip install django
pip install djangorestframework
pip install psycopg2-binary
pip install python-decouple
pip install celery
pip install redis

# 5. Save packages list
pip freeze > requirements.txt

# 6. Confirm everything installed
django-admin --version
python -c "import rest_framework; print('DRF installed')"

# 7. Create .gitignore
# create file called .gitignore and add:
# venv/
# __pycache__/
# *.pyc
# .env
```

