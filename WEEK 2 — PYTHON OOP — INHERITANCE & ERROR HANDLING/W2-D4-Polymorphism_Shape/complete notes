```python
# ============================================================
# CONCEPT 4: isinstance() — CHECK OBJECT TYPE
# ============================================================

c = Circle(5)
s = Square(4)

print(isinstance(c, Circle))   # True — c is a Circle object
print(isinstance(c, Shape))    # True — c is also a Shape (parent)
print(isinstance(c, Square))   # False — c is not a Square
print(isinstance(s, Shape))    # True — s is also a Shape

# isinstance() used in Django views to check object types
# useful when you need different behaviour based on object type
# but usually polymorphism removes the need for isinstance()
```

