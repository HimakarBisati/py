```python
# ============================================================
# CONCEPT 3: DANGEROUS SILENT BUG — FORGETTING TO OVERRIDE
# ============================================================

class Hexagon(Shape):
    def __init__(self, side):
        self.side = side
    # forgot to override area() and perimeter()

h = Hexagon(5)
print(h.area())       # 0 — uses parent's default, not correct
print(h.perimeter())  # 0 — wrong answer, NO crash
# this is a silent bug — most dangerous kind
# always override both methods in every child
# or add a check in parent to force children to implement:

class ShapeStrict:
    def area(self):
        raise NotImplementedError("Every shape must implement area()")
        # raise NotImplementedError = forces child to override
        # if child forgets — crash with clear error message
        # better than silently returning 0

    def perimeter(self):
        raise NotImplementedError("Every shape must implement perimeter()")
```

