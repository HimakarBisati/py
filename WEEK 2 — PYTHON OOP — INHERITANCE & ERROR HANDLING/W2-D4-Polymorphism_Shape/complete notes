```python
# ============================================================
# DJANGO CONNECTION — HOW THIS LOOKS IN REAL PROJECT
# ============================================================

# Django uses polymorphism everywhere:

class Post(models.Model):
    def save(self, *args, **kwargs):
        # overriding Django's parent save() method
        # same as Circle overriding Shape's area()
        self.title = self.title.upper()  # custom logic before saving
        super().save(*args, **kwargs)    # then call parent's save()

class Comment(models.Model):
    def save(self, *args, **kwargs):
        # Comment also overrides save() — different behaviour
        self.content = self.content.strip()  # remove whitespace
        super().save(*args, **kwargs)

# Post.save() and Comment.save() = same method name
# each model handles it differently — polymorphism
# Django calls .save() the same way on any model
# each model does its own thing — exactly like shapes and area()

# In your AI Job Portal:
# JobApplication.save() → calculate AI score before saving
# Job.save() → validate salary before saving
# User.save() → hash password before saving
# same .save() call, completely different behaviour per model
```

