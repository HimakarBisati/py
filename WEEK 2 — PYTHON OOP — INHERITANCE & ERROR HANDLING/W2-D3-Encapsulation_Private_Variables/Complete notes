# ============================================================
# DJANGO CONNECTION — HOW THIS LOOKS IN REAL PROJECT
# ============================================================

# In your AI Job Portal (Week 7), you will write:

class JobApplication(models.Model):
    resume_score = models.IntegerField(default=0)
    status = models.CharField(default="pending")

    def update_status(self, new_status):
        # controlled way to change status — same as set_balance()
        # validates before allowing change
        valid_statuses = ["pending", "shortlisted", "rejected"]
        if new_status in valid_statuses:
            self.status = new_status
            self.save()  # saves to database
        else:
            raise ValueError("Invalid status")
            # raise = trigger error — same as printing "Invalid" in BankAccount

    # In Django, models.IntegerField, models.CharField = controlled setters
    # they validate data type before saving to database
    # same concept as __balance — controlled access to data
```

