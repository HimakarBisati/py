```python
# ============================================================
# CONCEPT 2: WHAT HAPPENS WITHOUT ENCAPSULATION
# ============================================================

class BankAccountWrong:
    def __init__(self, owner, balance):
        self.owner = owner
        self.balance = balance  # public — no protection

acc = BankAccountWrong("Ravi", 1000)
acc.balance = -99999
# NO ERROR — Python allows this
# balance is now -99999 — data is broken
# no validation, no protection
# this is exactly the bug encapsulation prevents

print(acc.balance)  # -99999 — silently wrong, no crash


class BankAccountCorrect:
    def __init__(self, owner, balance):
        self.owner = owner
        self.__balance = balance  # private — protected

acc2 = BankAccountCorrect("Ravi", 1000)
acc2.__balance = -99999
# AttributeError — blocked from outside
# must use set_balance() which validates first
```

