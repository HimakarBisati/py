# ============================================================
# CONCEPT 3: NAME MANGLING — HOW PYTHON HIDES PRIVATE
# ============================================================

class Example:
    def __init__(self):
        self.__secret = "hidden"
        # Python internally renames __secret to _Example__secret
        # this is called name mangling
        # so acc.__balance fails but acc._BankAccount__balance works
        # but NEVER access private data this way in real code
        # it breaks the whole point of encapsulation

e = Example()
# print(e.__secret)           # AttributeError — blocked
# print(e._Example__secret)   # "hidden" — works but NEVER do this
# use getter methods only — that's the correct approach
```

