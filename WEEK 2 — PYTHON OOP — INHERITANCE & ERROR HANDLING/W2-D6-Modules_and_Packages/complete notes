```python
# ============================================================
# CONCEPT 4: INSTALLING EXTERNAL PACKAGES WITH pip
# ============================================================

# pip = Python's package manager
# installs packages from internet (PyPI — Python Package Index)

# IN TERMINAL (inside your venv):
# pip install requests
# pip install django
# pip install djangorestframework

# After installing requests:
import requests

response = requests.get("https://api.github.com")
# sends HTTP GET request to GitHub API
# response = server's reply

print(response.status_code)
# 200 = success
# 404 = not found
# 500 = server error

print(response.json())
# .json() = converts response body to Python dictionary
# same as what your Django API will return to clients later

# pip freeze — shows all installed packages with versions
# pip freeze > requirements.txt — saves list to file
# pip install -r requirements.txt — installs all from file
# requirements.txt used so others can recreate your exact environment
```

