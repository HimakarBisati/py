```python
# ============================================================
# CONCEPT 3: if __name__ == "__main__" — IMPORTANT PATTERN
# ============================================================

# shapes.py

class Circle:
    def __init__(self, radius):
        self.radius = radius

    def area(self):
        return 3.14 * self.radius * self.radius

def greet():
    print("Hello from shapes")

# THIS CODE RUNS ONLY WHEN shapes.py IS RUN DIRECTLY
# when imported from another file — this block is SKIPPED
if __name__ == "__main__":
    c = Circle(5)
    print(c.area())   # only runs when you run shapes.py directly
    greet()           # not when main.py imports shapes

# __name__ = "__main__" when file is run directly
# __name__ = "shapes" when file is imported
# this pattern prevents test/demo code from running on import
# you'll see this in every Python file in real projects
```

