```python
# ============================================================
# DJANGO CONNECTION — HOW THIS LOOKS IN REAL PROJECT
# ============================================================

# Django app structure = package with modules:

# blog/                    ← Django app = package
# ├── __init__.py          ← makes it a package
# ├── models.py            ← module (your database tables)
# ├── views.py             ← module (your API logic)
# ├── urls.py              ← module (your URL routing)
# ├── serializers.py       ← module (converts data to JSON)
# └── admin.py             ← module (admin panel config)

# In views.py — importing from other modules:
from .models import Post
# . = current package (blog app)
# models = models.py file
# Post = class inside models.py

from .serializers import PostSerializer
# same pattern — import from serializers.py

from django.contrib.auth.models import User
# importing from Django's own package
# django = package, contrib.auth.models = nested module path
# User = class inside that module

# Everything in Django = modules and packages
# What you learned today IS how Django is structured
```

