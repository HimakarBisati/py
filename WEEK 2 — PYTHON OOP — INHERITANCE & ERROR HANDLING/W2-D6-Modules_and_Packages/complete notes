```python
# ============================================================
# CONCEPT 2: PACKAGE — FOLDER OF MODULES
# ============================================================

# Create this folder structure:
#
# myproject/
# │
# ├── main.py
# │
# └── utils/              ← PACKAGE (folder)
#     ├── __init__.py     ← makes this folder a package (can be empty)
#     ├── helpers.py      ← module inside package
#     └── validators.py   ← another module inside package


# utils/helpers.py
def square(n):
    return n * n

def cube(n):
    return n * n * n

def add(a, b):
    return a + b


# utils/validators.py
def is_valid_email(email):
    return "@" in email and "." in email

def is_valid_age(age):
    return 0 < age < 150

def is_valid_salary(salary):
    return salary > 0


# main.py — importing from package
from utils.helpers import square, cube
# utils = package folder name
# helpers = module (file) inside that package
# square, cube = specific functions to import

print(square(5))   # 25
print(cube(3))     # 27

from utils.validators import is_valid_email, is_valid_salary

print(is_valid_email("ravi@gmail.com"))  # True
print(is_valid_email("ravimail.com"))    # False
print(is_valid_salary(-100))             # False


# utils/__init__.py — can also define what's available from package
# leave empty for now — that's fine for basic packages
```

