```python
# ============================================================
# CONCEPT 3: MULTIPLE EXCEPT BLOCKS + GENERIC EXCEPTION
# ============================================================

def safe_divide_input(a, b):
    try:
        result = a / b
        return result

    except ZeroDivisionError:
        # most specific error — check first
        print("Cannot divide by zero")
        return None

    except TypeError:
        # another specific error — check second
        print("Invalid input type")
        return None

    except Exception as e:
        # GENERIC — catches ANY other error not caught above
        # always put this LAST — most specific first, generic last
        # if put first — catches everything, specific blocks never run
        print(f"Unexpected error: {e}")
        return None

    finally:
        print("Operation complete")
        # always runs — success or failure


print(safe_divide_input(10, 2))    # 5.0 → Operation complete
print(safe_divide_input(10, 0))    # None → Operation complete
print(safe_divide_input(10, "x"))  # None → Operation complete
```

