# ============================================================
# CONCEPT 2: raise — TRIGGER YOUR OWN ERROR
# ============================================================

def get_user_age(age):
    try:
        if age < 0:
            raise ValueError("Age cannot be negative")
            # raise = trigger error yourself on purpose
            # age = -5 is valid Python — no automatic crash
            # but makes no sense in your app — so YOU raise the error
            # raise stops execution here, jumps to except immediately

        if age > 150:
            raise ValueError("Age cannot be more than 150")
            # another logical validation — your rules, not Python's

        print(f"Age accepted: {age}")

    except ValueError as e:
        # 'as e' = captures the error object
        # e contains the message you passed to ValueError()
        print(f"Error: {e}")
        # Error: Age cannot be negative


get_user_age(25)    # Age accepted: 25
get_user_age(-5)    # Error: Age cannot be negative
get_user_age(200)   # Error: Age cannot be more than 150
```

