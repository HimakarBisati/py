# ============================================================
# CONCEPT 4: COMMON ERRORS TO KNOW
# ============================================================

# ZeroDivisionError — dividing by zero
result = 10 / 0

# TypeError — wrong data type
result = "hello" + 5

# ValueError — right type, wrong value
number = int("abc")  # "abc" can't convert to int

# IndexError — list index doesn't exist
my_list = [1, 2, 3]
print(my_list[10])  # index 10 doesn't exist

# KeyError — dictionary key doesn't exist
my_dict = {"name": "Ravi"}
print(my_dict["age"])  # "age" key doesn't exist

# AttributeError — attribute doesn't exist on object
class Car:
    def __init__(self):
        self.brand = "Toyota"

c = Car()
print(c.color)  # 'color' attribute doesn't exist


# HANDLING EACH:
def safe_operations():
    try:
        my_list = [1, 2, 3]
        print(my_list[10])          # IndexError

    except IndexError:
        print("Index out of range")

    try:
        my_dict = {"name": "Ravi"}
        print(my_dict["age"])       # KeyError

    except KeyError:
        print("Key not found")

    try:
        number = int("abc")         # ValueError

    except ValueError:
        print("Cannot convert to integer")

safe_operations()
```

