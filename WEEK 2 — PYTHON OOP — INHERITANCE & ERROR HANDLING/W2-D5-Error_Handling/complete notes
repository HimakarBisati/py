# In your AI Job Portal (Week 4), every view will look like:

from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework import status

class JobCreateView(APIView):
    def post(self, request):
        try:
            title = request.data["title"]
            # KeyError if "title" not in request — caught below

            salary = int(request.data["salary"])
            # ValueError if salary not a number — caught below

            if salary <= 0:
                raise ValueError("Salary must be positive")
                # your own validation — same as raise in Employee example

            job = Job.objects.create(title=title, salary=salary)
            return Response({"message": "Job created"}, status=201)

        except KeyError as e:
            return Response({"error": f"Missing field: {e}"}, status=400)
            # missing required field — return proper error response

        except ValueError as e:
            return Response({"error": str(e)}, status=400)
            # invalid value — return proper error response

        except Exception as e:
            return Response({"error": "Something went wrong"}, status=500)
            # unexpected error — return 500 server error

# try/except in views = API never crashes on bad input
# always returns proper JSON error response instead
# this is exactly how production backend APIs work
