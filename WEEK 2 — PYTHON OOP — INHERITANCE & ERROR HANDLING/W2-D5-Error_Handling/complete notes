# ============================================================
# CONCEPT 5: CUSTOM EXCEPTION CLASS
# ============================================================

class InvalidSalaryError(Exception):
    # creating own custom exception
    # inherits from Exception — base class for all errors
    # use when built-in errors don't describe your specific problem clearly
    pass

class InvalidAgeError(Exception):
    pass


def create_employee(name, salary, age):
    try:
        if salary <= 0:
            raise InvalidSalaryError("Salary must be positive")
            # raise your own custom exception — very clear error message

        if age < 18:
            raise InvalidAgeError("Employee must be 18 or older")

        print(f"Employee {name} created successfully")

    except InvalidSalaryError as e:
        print(f"Salary Error: {e}")

    except InvalidAgeError as e:
        print(f"Age Error: {e}")


create_employee("Ravi", 30000, 25)   # Employee Ravi created successfully
create_employee("Sai", -5000, 25)    # Salary Error: Salary must be positive
create_employee("Kiran", 20000, 16)  # Age Error: Employee must be 18 or older
```

