from django.contrib.auth.models import AbstractUser

class CustomUser(AbstractUser):
    # AbstractUser = parent class (Django's built-in user)
    # CustomUser = child class with extra fields

    # super().__init__ handled by Django automatically here
    # just add your extra fields:

    phone_number = models.CharField(max_length=15)
    user_type = models.CharField(max_length=20)
    # choices: "admin", "company", "candidate"

    # AbstractUser already has: username, email, password, first_name, last_name
    # CustomUser adds: phone_number, user_type on top
    # exactly like Manager adding team_size on top of Employee's name, salary

# class CustomUser(AbstractUser) = class Manager(Employee)
# phone_number, user_type = self.team_size
# AbstractUser fields = self.name, self.salary
