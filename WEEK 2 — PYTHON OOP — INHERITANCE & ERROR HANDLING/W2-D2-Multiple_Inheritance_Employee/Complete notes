**W2-D2-Multiple_Inheritance_Employee**

---

**What and Why:**
Yesterday child class only added its own sound — parent's `__init__` was enough. Today child class needs **extra attributes** on top of parent's. New concept: `super()` — calls parent's method from inside child. This is how Django model inheritance works — child model gets all parent fields plus adds its own extra fields.

---

```python
# ============================================================
# CONCEPT 1: CHILD CLASS WITH EXTRA ATTRIBUTES — super()
# ============================================================

class Employee:  # PARENT CLASS
    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
        # parent saves name and salary on every Employee object

    def info(self):
        print(f"{self.name} earns {self.salary}")

    def give_raise(self, amount):
        self.salary += amount
        # adds amount to salary — state changing
        print(f"{self.name} new salary: {self.salary}")


class Manager(Employee):  # Manager inherits from Employee
    def __init__(self, name, salary, team_size):
        super().__init__(name, salary)
        # super() = calls parent's __init__ from inside child
        # super().__init__(name, salary) = Employee.__init__(self, name, salary)
        # lets parent set up name and salary first
        # WITHOUT this line: self.name and self.salary never get set
        # child's __init__ completely replaces parent's — must call super() manually

        self.team_size = team_size
        # adding extra attribute on top of what parent set up
        # Manager has name, salary (from parent) + team_size (own)

    def info(self):
        super().info()
        # super().info() = calls parent's info() first
        # prints: "Ravi earns 60000"
        # then adds Manager-specific info below
        print(f"Manages a team of {self.team_size}")
        # full output:
        # Ravi earns 60000
        # Manages a team of 5


class Developer(Employee):
    def __init__(self, name, salary, tech_stack):
        super().__init__(name, salary)
        # same pattern — let parent set up name and salary
        self.tech_stack = tech_stack
        # Developer's own extra attribute

    def info(self):
        super().info()
        # calls parent's info() first
        print(f"Works with: {self.tech_stack}")


class Intern(Employee):
    def __init__(self, name, salary, mentor):
        super().__init__(name, salary)
        self.mentor = mentor
        # Intern's own extra attribute

    def info(self):
        super().info()
        print(f"Mentored by: {self.mentor}")


# ============================================================
# CREATING OBJECTS AND TESTING
# ============================================================

m1 = Manager("Ravi", 60000, 5)
d1 = Developer("Sai", 50000, "Python, Django")
i1 = Intern("Kiran", 15000, "Ravi")

m1.info()
# Ravi earns 60000
# Manages a team of 5

d1.info()
# Sai earns 50000
# Works with: Python, Django

i1.info()
# Kiran earns 15000
# Mentored by: Ravi

# give_raise() inherited from parent — works on all children
m1.give_raise(10000)  # Ravi new salary: 70000
d1.give_raise(5000)   # Sai new salary: 55000
i1.give_raise(2000)   # Kiran new salary: 17000
# no need to rewrite give_raise() in any child — inherited automatically
```

