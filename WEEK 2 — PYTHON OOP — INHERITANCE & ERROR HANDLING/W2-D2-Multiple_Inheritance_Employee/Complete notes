```python
# ============================================================
# CONCEPT 3: super() IN METHOD — NOT JUST __init__
# ============================================================

class Animal:
    def describe(self):
        print("I am an animal")

class Dog(Animal):
    def describe(self):
        super().describe()      # calls Animal's describe() first
        print("I am a Dog")     # then adds own line

d = Dog()
d.describe()
# I am an animal
# I am a Dog

# super() works in any method, not just __init__
# use it when you want parent's behaviour PLUS extra child behaviour
# skip it when you want to COMPLETELY replace parent's behaviour
```

