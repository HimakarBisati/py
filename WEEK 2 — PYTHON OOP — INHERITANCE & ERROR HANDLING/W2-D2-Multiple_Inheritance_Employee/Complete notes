```python
# ============================================================
# CONCEPT 2: WHAT BREAKS WITHOUT super()
# ============================================================

class ManagerWrong(Employee):
    def __init__(self, name, salary, team_size):
        # forgot super().__init__(name, salary)
        self.team_size = team_size
        # only team_size saved — name and salary never set

m_wrong = ManagerWrong("Ravi", 60000, 5)
print(m_wrong.team_size)  # 5 — works
print(m_wrong.name)       # AttributeError: has no attribute 'name'
# name was never saved because parent's __init__ never ran
# always call super().__init__() first thing in child's __init__


class ManagerCorrect(Employee):
    def __init__(self, name, salary, team_size):
        super().__init__(name, salary)  # parent runs first — name, salary saved
        self.team_size = team_size      # then add own attribute
```

