```python
# ============================================================
# CONCEPT 3: READ — GET DATA FROM DATABASE
# ============================================================

from blog.models import Post

# GET ALL RECORDS
posts = Post.objects.all()
# SELECT * FROM blog_post in SQL
# returns QuerySet — like a list of Post objects
print(posts)  # <QuerySet [<Post: My First Post>, ...]>

for post in posts:
    print(post.title, post.is_published)
# loop through QuerySet like a normal list

# GET FIRST AND LAST
first_post = Post.objects.first()
# returns first object ordered by id
last_post = Post.objects.last()
# returns last object ordered by id

# GET ONE SPECIFIC RECORD — get()
post = Post.objects.get(id=1)
# SELECT * FROM blog_post WHERE id=1
# returns SINGLE object — not a list
# IMPORTANT: crashes with error if:
# - no record found (DoesNotExist error)
# - more than one record found (MultipleObjectsReturned error)
# use only when you're 100% sure one record exists
print(post.title)  # My First Post

# SAFE WAY — filter() instead of get()
posts = Post.objects.filter(id=1)
# returns QuerySet — empty list if not found, never crashes
# use filter() when not sure if record exists
# use get() only for primary key lookups

# COUNT RECORDS
count = Post.objects.count()
# SELECT COUNT(*) FROM blog_post
print(count)  # total number of posts

# CHECK IF EXISTS
exists = Post.objects.filter(title="My First Post").exists()
# returns True or False
# faster than filter() when you only need to know if exists
print(exists)  # True
```

