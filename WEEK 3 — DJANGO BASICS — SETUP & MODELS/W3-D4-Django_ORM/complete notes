```python
# ============================================================
# CONCEPT 6: DELETE — REMOVE DATA FROM DATABASE
# ============================================================

from blog.models import Post

# WAY 1 — delete single object
post = Post.objects.get(id=1)
post.delete()
# DELETE FROM blog_post WHERE id=1
# object is gone from database — id=1 never reused

# WAY 2 — bulk delete
Post.objects.filter(is_published=False).delete()
# DELETE FROM blog_post WHERE is_published=False
# deletes ALL unpublished posts in one query

Post.objects.all().delete()
# DELETE FROM blog_post
# deletes EVERYTHING — be careful with this
```

