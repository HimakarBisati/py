```python
# ============================================================
# CONCEPT 4: FILTER — QUERY WITH CONDITIONS
# ============================================================

from blog.models import Post

# BASIC FILTER
published_posts = Post.objects.filter(is_published=True)
# SELECT * FROM blog_post WHERE is_published=True
# returns QuerySet of all published posts

unpublished = Post.objects.filter(is_published=False)

# FILTER WITH MULTIPLE CONDITIONS (AND)
posts = Post.objects.filter(is_published=True, views_count=0)
# WHERE is_published=True AND views_count=0

# EXCLUDE — opposite of filter
posts = Post.objects.exclude(is_published=True)
# returns all posts WHERE is_published != True

# FIELD LOOKUPS — powerful filtering options
Post.objects.filter(title__exact="My First Post")
# exact match — same as title="My First Post"

Post.objects.filter(title__iexact="my first post")
# case-insensitive exact match

Post.objects.filter(title__contains="First")
# title contains "First" — case sensitive
# LIKE '%First%' in SQL

Post.objects.filter(title__icontains="first")
# case-insensitive contains

Post.objects.filter(views_count__gt=10)
# views_count > 10 (gt = greater than)

Post.objects.filter(views_count__gte=10)
# views_count >= 10 (gte = greater than or equal)

Post.objects.filter(views_count__lt=100)
# views_count < 100 (lt = less than)

Post.objects.filter(views_count__lte=100)
# views_count <= 100 (lte = less than or equal)

Post.objects.filter(id__in=[1, 2, 3])
# WHERE id IN (1, 2, 3)

Post.objects.filter(title__startswith="My")
# title starts with "My"

Post.objects.filter(title__endswith="Post")
# title ends with "Post"

# ORDER BY
Post.objects.all().order_by('created_at')
# ascending order (oldest first)

Post.objects.all().order_by('-created_at')
# descending order — minus sign = reverse
# newest first

# LIMIT RESULTS
Post.objects.all()[:5]
# first 5 results — Python slice
# SELECT * FROM blog_post LIMIT 5

Post.objects.all()[5:10]
# results 6 to 10 — offset + limit
```

