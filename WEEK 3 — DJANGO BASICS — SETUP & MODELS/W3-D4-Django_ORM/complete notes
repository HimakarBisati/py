```python
# ============================================================
# CONCEPT 5: UPDATE — CHANGE DATA IN DATABASE
# ============================================================

from blog.models import Post

# WAY 1 — update single object
post = Post.objects.get(id=1)
post.title = "Updated Title"
post.is_published = True
post.save()
# save() = UPDATE blog_post SET title=... WHERE id=1
# must call save() after changing attributes
# without save() — changes stay in memory only, never in database

# WAY 2 — update() — bulk update without fetching objects
Post.objects.filter(is_published=False).update(views_count=0)
# UPDATE blog_post SET views_count=0 WHERE is_published=False
# updates ALL matching records in one SQL query
# faster than looping and saving each object individually
# use for bulk updates

Post.objects.filter(id=1).update(title="New Title")
# update specific record

# WAY 3 — update_or_create()
post, created = Post.objects.update_or_create(
    title="Specific Post",
    defaults={"content": "Updated content", "is_published": True}
)
# if post with title exists — update it with defaults
# if not exists — create it with title + defaults
```

