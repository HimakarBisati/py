```python
# ============================================================
# CONCEPT 7: CHAINING QUERYSETS
# ============================================================

from blog.models import Post

# QuerySets are LAZY — no database hit until you evaluate
query = Post.objects.filter(is_published=True)
# NO database query yet — just builds the query

query = query.filter(views_count__gt=10)
# still no database query — adds condition

query = query.order_by('-created_at')
# still no database query — adds ordering

results = list(query)
# NOW database query runs — evaluates QuerySet
# SELECT * FROM blog_post WHERE is_published=True
# AND views_count>10 ORDER BY created_at DESC

# CHAINING IN ONE LINE:
results = Post.objects.filter(
    is_published=True
).filter(
    views_count__gt=10
).order_by('-created_at')[:5]
# filter → filter → order → limit — all in one chain
# only ONE database query runs at the end
```

