```python
# ============================================================
# CONCEPT 5: settings.py — KEY SECTIONS TO KNOW NOW
# ============================================================

# Open myproject/settings.py and understand these:

from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent.parent
# BASE_DIR = root folder of your project
# used to build paths to other files

SECRET_KEY = 'django-insecure-...'
# random secret key — used for security (sessions, CSRF)
# NEVER push this to GitHub as-is
# Week 5 — you move this to .env file

DEBUG = True
# True = shows detailed error pages during development
# False = hides errors in production (security)
# ALWAYS False when deploying

ALLOWED_HOSTS = []
# empty = only localhost allowed
# in production: ['yourdomain.com', 'yourapp.onrender.com']

INSTALLED_APPS = [
    'django.contrib.admin',       # admin panel at /admin/
    'django.contrib.auth',        # login, logout, users
    'django.contrib.contenttypes',
    'django.contrib.sessions',
    'django.contrib.messages',
    'django.contrib.staticfiles', # CSS, JS, images
]
# you add your own apps here later:
# 'blog',
# 'rest_framework',

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.sqlite3',
        'NAME': BASE_DIR / 'db.sqlite3',
    }
}
# SQLite = simple file-based database
# fine for development, not for production
# Saturday = switch to PostgreSQL

LANGUAGE_CODE = 'en-us'
TIME_ZONE = 'Asia/Kolkata'
# change to your timezone — important for timestamps in database
```

