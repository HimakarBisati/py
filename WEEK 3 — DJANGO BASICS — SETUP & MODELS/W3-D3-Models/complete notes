```bash
# ============================================================
# CONCEPT 3: MIGRATIONS — TURN MODEL INTO DATABASE TABLE
# ============================================================

# After writing your model, run these two commands:

# STEP 1:
python manage.py makemigrations
# makemigrations = Django reads your models.py
# creates a migration FILE describing what changed
# migration file = instructions for database
# creates: blog/migrations/0001_initial.py
# you'll see: "Migrations for 'blog': blog/migrations/0001_initial.py - Create model Post"

# STEP 2:
python manage.py migrate
# migrate = reads migration file
# ACTUALLY creates the table in database
# runs the SQL commands for you
# you'll see: "Applying blog.0001_initial... OK"

# RULE — always run BOTH in this order, every time you change models.py:
# 1. python manage.py makemigrations   ← write down the changes
# 2. python manage.py migrate          ← apply the changes

# What SQL Django runs behind the scenes (you don't write this):
# CREATE TABLE "blog_post" (
#     "id" integer NOT NULL PRIMARY KEY AUTOINCREMENT,
#     "title" varchar(200) NOT NULL,
#     "content" text NOT NULL,
#     "created_at" datetime NOT NULL,
#     "updated_at" datetime NOT NULL,
#     "is_published" bool NOT NULL
# );
# Django adds 'id' field automatically — every model gets auto id
```

