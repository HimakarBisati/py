```python
# ============================================================
# CONCEPT 4: CHECK DATABASE — DJANGO SHELL
# ============================================================

# Open Django shell:
# python manage.py shell

# In shell — test your model:
from blog.models import Post

# Create a post object and save to database:
p1 = Post(title="My First Post", content="Hello Django World")
p1.save()
# save() = INSERT INTO blog_post (title, content...) in SQL
# p1.id = 1 (auto-assigned by database)
# p1.created_at = current datetime (auto-set)

# Shorter way — create AND save in one line:
p2 = Post.objects.create(title="Second Post", content="Learning Models")
# .objects.create() = creates object + saves to DB in one step

# Check saved posts:
print(p1.id)          # 1
print(p1.title)       # My First Post
print(p1.created_at)  # 2024-01-15 10:30:00

# Get all posts from database:
posts = Post.objects.all()
print(posts)
# <QuerySet [<Post: My First Post>, <Post: Second Post>]>
# QuerySet = list of database objects
```

