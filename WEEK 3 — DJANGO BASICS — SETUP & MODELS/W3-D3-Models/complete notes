# ============================================================
# CONCEPT 2: COMMON DJANGO FIELD TYPES
# ============================================================

class FieldExamples(models.Model):

    # TEXT FIELDS
    name = models.CharField(max_length=100)
    # short text — names, titles, emails

    description = models.TextField()
    # long text — content, descriptions, notes

    slug = models.SlugField(max_length=100, unique=True)
    # URL-friendly text — "my-post-title" (no spaces, lowercase)
    # unique=True = no two rows can have same slug

    # NUMBER FIELDS
    age = models.IntegerField()
    # whole numbers — 1, 2, 100, -5

    salary = models.DecimalField(max_digits=10, decimal_places=2)
    # decimal numbers — 50000.00, 1234.56
    # max_digits=10 = maximum 10 digits total
    # decimal_places=2 = 2 digits after decimal point

    price = models.FloatField()
    # floating point — less precise than DecimalField
    # use DecimalField for money, FloatField for scientific values

    # DATE/TIME FIELDS
    birth_date = models.DateField()
    # date only — 2024-01-15 (no time)

    created_at = models.DateTimeField(auto_now_add=True)
    # date + time — 2024-01-15 10:30:00

    # BOOLEAN FIELD
    is_active = models.BooleanField(default=True)
    # True or False only

    # EMAIL FIELD
    email = models.EmailField(max_length=254, unique=True)
    # validates email format automatically
    # unique=True = no duplicate emails

    # FILE/IMAGE FIELDS
    resume = models.FileField(upload_to='resumes/')
    # stores file — needed for AI Job Portal (resume upload)
    # upload_to = subfolder inside MEDIA_ROOT

    profile_picture = models.ImageField(upload_to='profiles/')
    # stores image file
    # needs Pillow package: pip install Pillow

    # NULL AND BLANK
    phone = models.CharField(max_length=15, null=True, blank=True)
    # null=True = database can store NULL (empty in DB)
    # blank=True = form validation allows empty value
    # use both together for optional fields
```

