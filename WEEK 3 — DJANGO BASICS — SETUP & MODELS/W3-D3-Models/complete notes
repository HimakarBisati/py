# ============================================================
# DJANGO CONNECTION — AI JOB PORTAL MODELS PREVIEW
# ============================================================

# In your AI Job Portal (Week 7), you will write:

class Job(models.Model):
    title = models.CharField(max_length=200)
    description = models.TextField()
    salary = models.DecimalField(max_digits=10, decimal_places=2)
    location = models.CharField(max_length=100)
    job_type = models.CharField(max_length=50)  # full-time, part-time
    is_active = models.BooleanField(default=True)
    created_at = models.DateTimeField(auto_now_add=True)

    def __str__(self):
        return self.title


class JobApplication(models.Model):
    resume_score = models.IntegerField(default=0)
    status = models.CharField(max_length=20, default="pending")
    applied_at = models.DateTimeField(auto_now_add=True)

    def __str__(self):
        return f"Application {self.id}"

# same exact pattern as Post model today
# different field names, same concept
# this is why today matters — Job and JobApplication
# are just Post with different fields
```

