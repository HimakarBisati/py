```python
# ============================================================
# CONCEPT 4: CONNECT TO MAIN urls.py
# ============================================================

# Open myproject/urls.py — this is the MAIN url file
# By default it looks like:

from django.contrib import admin
from django.urls import path

urlpatterns = [
    path('admin/', admin.site.urls),
]

# ADD your blog app URLs:

from django.contrib import admin
from django.urls import path, include
# include = includes another urls.py file

urlpatterns = [
    path('admin/', admin.site.urls),
    path('blog/', include('blog.urls')),
    # 'blog/' = URL prefix for all blog app URLs
    # include('blog.urls') = forward to blog/urls.py
    # any URL starting with 'blog/' goes to blog app
    # blog/urls.py then decides which view handles it

    # HOW IT WORKS:
    # request comes to /blog/hello/
    # main urls.py sees 'blog/' prefix → forwards to blog.urls
    # blog/urls.py sees 'hello/' → runs hello_view
    # hello_view returns HttpResponse("Hello World")
    # browser shows "Hello World"
]
```

