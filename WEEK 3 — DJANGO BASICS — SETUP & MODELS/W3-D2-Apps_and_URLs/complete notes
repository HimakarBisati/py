# In your AI Job Portal (Week 7), your views will look like:

from rest_framework.views import APIView
from rest_framework.response import Response

class JobListView(APIView):
    # class-based view — inherits from APIView (Week 4)
    # same concept as today but more powerful

    def get(self, request):
        # handles GET /jobs/ — returns list of all jobs
        return Response({"message": "List of all jobs"})

    def post(self, request):
        # handles POST /jobs/ — creates new job
        return Response({"message": "Job created"})

# today's hello_view → Week 4's JobListView
# HttpResponse → Response (JSON)
# function view → class-based view
# same concept, more powerful version
```

