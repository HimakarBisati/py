```bash
# ============================================================
# CONCEPT 1: CREATE AN APP
# ============================================================

# Make sure server is stopped (CTRL+C) and venv is active

python manage.py startapp blog
# startapp = creates new app called 'blog'
# creates this folder structure:

# blog/
# ├── __init__.py      ← makes blog a Python package
# ├── admin.py         ← register models for admin panel
# ├── apps.py          ← app configuration (don't touch now)
# ├── models.py        ← database tables go here
# ├── tests.py         ← automated tests (ignore for now)
# ├── views.py         ← YOUR LOGIC GOES HERE — handles requests
# └── migrations/      ← database migration files (auto-generated)
#     └── __init__.py


# STEP 2 — Register app in settings.py
# Open myproject/settings.py
# Find INSTALLED_APPS and add 'blog':

INSTALLED_APPS = [
    'django.contrib.admin',
    'django.contrib.auth',
    'django.contrib.contenttypes',
    'django.contrib.sessions',
    'django.contrib.messages',
    'django.contrib.staticfiles',
    'blog',   # ← ADD YOUR APP HERE
    # if you forget this — Django ignores your app completely
    # models won't migrate, app won't work
]
```

