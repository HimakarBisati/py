```python
# ============================================================
# CONCEPT 2: WRITE YOUR FIRST VIEW
# ============================================================

# Open blog/views.py and write this:

from django.http import HttpResponse
# HttpResponse = Django class that creates HTTP response
# every view MUST return a response — Django requires this


def hello_view(request):
    # VIEW = function that handles one specific HTTP request
    # request = object containing everything about incoming request
    #   request.method = "GET", "POST", "PUT", "DELETE"
    #   request.data = data sent in request body (POST/PUT)
    #   request.user = who made the request
    # every view takes 'request' as first parameter — always

    return HttpResponse("Hello World")
    # HttpResponse = simplest response
    # sends plain text "Hello World" back to browser
    # later you'll return JSON instead of plain text
    # that's what DRF (Week 4) adds on top of this


def about_view(request):
    return HttpResponse("This is the about page")
    # another view — handles /blog/about/ URL


def greet_view(request, name):
    # name = URL parameter — value comes from URL itself
    # e.g. /blog/greet/Ravi/ → name = "Ravi"
    return HttpResponse(f"Hello {name}! Welcome to our blog.")
```

---

```python
# ============================================================
# CONCEPT 3: CREATE APP-LEVEL urls.py
# ============================================================

# blog/urls.py — CREATE THIS FILE YOURSELF (doesn't exist by default)
# right click blog folder → new file → urls.py

from django.urls import path
from . import views
# . = current package (blog app)
# import views = import blog/views.py

urlpatterns = [
    path('hello/', views.hello_view),
    # path() = connects a URL pattern to a view function
    # 'hello/' = URL pattern — matches /blog/hello/
    # views.hello_view = view function to run when URL matches
    # NO () at end of hello_view — passing function, not calling it

    path('about/', views.about_view),
    # /blog/about/ → runs about_view

    path('greet/<str:name>/', views.greet_view),
    # <str:name> = URL parameter — captures string from URL
    # /blog/greet/Ravi/ → name = "Ravi" → passed to greet_view
    # str = data type (string), name = variable name
]
```

